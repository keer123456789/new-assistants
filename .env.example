# ====== LLM 配置（必填）======
# 选择一个填入下面的三个变量即可，无需改任何代码

# ----- OpenAI（官方） -----
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=    # 留空

# ----- 智谱 GLM（推荐，完全免费）-----
# LLM_API_KEY=你的key
# LLM_MODEL=glm-4-flash        # 免费，质量够用
# LLM_MODEL=glm-4-air          # 质量更好，便宜
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# ----- DeepSeek（性价比之王）-----
# LLM_API_KEY=你的key
# LLM_MODEL=deepseek-chat      # V3，~¥2/百万 tokens
# LLM_MODEL=deepseek-reasoner  # R1，推理更强
# LLM_BASE_URL=https://api.deepseek.com/v1

# ----- 通义千问（阿里）-----
# LLM_API_KEY=你的DashScope_APIKey
# LLM_MODEL=qwen-turbo         # 快速，便宜
# LLM_MODEL=qwen-plus          # 平衡
# LLM_MODEL=qwen-max           # 最强
# LLM_MODEL=qwen-long          # 超长上下文
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ----- 豆包（字节）-----
# LLM_API_KEY=你的ARK_APIKey
# LLM_MODEL=doubao-lite-32k
# LLM_MODEL=doubao-pro-32k
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ----- Kimi（月之暗面）-----
# LLM_API_KEY=你的Moonshot_APIKey
# LLM_MODEL=moonshot-v1-8k
# LLM_MODEL=moonshot-v1-32k
# LLM_BASE_URL=https://api.moonshot.cn/v1

# ----- Ollama（本地大模型，0 成本但需 GPU）-----
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2:7b
# LLM_BASE_URL=http://localhost:11434/v1


# ====== 代理（本地运行时需要）======
PROXY_URL=http://127.0.0.1:7897

# ====== Telegram Bot（推荐）======
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ====== Email（可选）======
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# ====== Bark (iOS，可选)======
BARK_URL=

# ====== Server酱 (微信推送，可选)======
SERVERCHAN_KEY=